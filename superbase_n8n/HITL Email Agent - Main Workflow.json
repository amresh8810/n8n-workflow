    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\n\nreturn [\n  {\n    json: {\n      to: body.From || '',\n      recipientName: 'Client',\n      subject: body.Subject || 'Important Update',\n      context: body.snippet || '',\n      tone: 'professional',\n      sender: 'Amresh Kumar'\n    }\n  }\n];"
      },
      "id": "b3b9f3ef-0dcf-4d30-ad2c-2cac5f8003f8",
      "name": "Setup Variables",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        240
      ]
    },
    {
