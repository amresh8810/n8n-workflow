        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer 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"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a professional email writer.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a professional email to {{$json.recipientName}} regarding {{$json.subject}}. Context: {{$json.context}}. Tone: {{$json.tone}}. Sign off as {{$json.sender}}.\"\n    }\n  ],\n  \"temperature\": 0.7\n}",
        "options": {}
      },
      "id": "ede04c68-4390-4ed5-a454-1dc723092df5",
      "name": "AI Draft Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        416,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      ...$json,\n      emailDraft: $json.choices[0].message.content\n    }\n  }\n];"
      },
      "id": "1c80b614-9c76-4bbf-bef9-3bc47c8ab5ac",
      "name": "Extract Email Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        240
      ]
    },
    {
      "parameters": {
        "chatId": "=6186941474",
        "text": "={{ $json.choices[0].message.content }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Approve & Send",
                    "additionalFields": {
                      "callback_data": "={{ \"approve:\" + $json.execId }}"
                    }
                  },
                  {
                    "text": "❌ Reject",
                    "additionalFields": {
                      "callback_data": "={{ \"reject:\" + $json.execId }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "Markdown"
        }
